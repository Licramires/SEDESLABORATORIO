@model ErrorViewModel
@{ ViewData["Title"] = "No se pudo completar la operación"; }
<div class="container silab-page"><section class="silab-panel p-4">
<h1>No se pudo completar la operación</h1>
<p>Vuelve a la pantalla anterior e inténtalo de nuevo. Si el problema continúa, informa al administrador indicando la referencia que aparece aquí.</p>
@if (Model.ShowRequestId) { <p><strong>Referencia:</strong> <code>@Model.RequestId</code></p> }
<a asp-area="publico" asp-controller="Publico" asp-action="Index" class="btn silab-btn-primary">Volver al inicio</a>
</section></div>
