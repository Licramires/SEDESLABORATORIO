@model List<SEDESLABORATORIO.Data.Entities.Usuario>
@{ ViewData["Title"] = "Usuarios"; }
<div class="container silab-page"><div class="silab-page-heading"><div><h1>Gestión de usuarios</h1><p class="text-muted mb-0">Administre las cuentas y los accesos del sistema.</p></div><div class="d-flex flex-wrap gap-2"><a asp-action="Roles" class="btn silab-btn-outline"><partial name="_Icon" model='"shield"' />Roles y permisos</a><a asp-action="Usuario" class="btn silab-btn-primary"><partial name="_Icon" model='"plus"' />Crear usuario</a></div></div>
<div class="stat-grid"><section class="silab-panel stat-card"><p>Usuarios totales</p><strong>@Model.Count</strong><small>Registrados en el sistema</small></section><section class="silab-panel stat-card is-success"><p>Activos</p><strong>@Model.Count(u => u.Activo)</strong><small>Con acceso habilitado</small></section><section class="silab-panel stat-card is-muted"><p>Inactivos</p><strong>@Model.Count(u => !u.Activo)</strong><small>Con acceso suspendido</small></section></div>
<div class="silab-panel table-responsive"><div class="silab-panel-header"><h2>Usuarios registrados</h2><small>@Model.Count cuentas</small></div><table class="table silab-table"><thead><tr><th scope="col">Nombre</th><th scope="col">Correo</th><th scope="col">Rol</th><th scope="col">Estado</th><th scope="col">Acción</th></tr></thead><tbody>
@foreach(var u in Model) { <tr><td><strong>@u.Nombre</strong></td><td>@u.Email</td><td>@u.Rol</td><td><span class="silab-status" data-state="@(u.Activo ? "aprobado" : "borrador")">@(u.Activo ? "Activo" : "Inactivo")</span></td><td><a asp-action="Usuario" asp-route-id="@u.Id" class="btn silab-btn-outline">Editar acceso</a></td></tr> }
</tbody></table></div></div>
