@model RequisitosAdminModel
@using SEDESLABORATORIO.Data.Entities
@{ ViewData["Title"] = "Requisitos de laboratorios"; var grupos = new List<SeccionRequisito?>();
 if(Model.Requisitos.Any(r => r.SeccionId == null)) grupos.Add(null); grupos.AddRange(Model.Secciones); }
<div class="container silab-page">
<div class="silab-page-heading"><div><h1>Requisitos de laboratorios</h1><p>Organice la documentación para registrar un nuevo laboratorio.</p></div><a asp-action="Seccion" class="btn silab-btn-primary">Añadir nueva sección</a></div>
<div class="d-flex flex-wrap gap-3 mb-4"><a asp-action="Requisito" class="btn silab-btn-outline">Añadir requisito</a><a asp-area="publico" asp-controller="Publico" asp-action="Requerimientos" class="btn silab-btn-outline">Ver requisitos publicados</a></div>
<p>Los cambios se aplican a los borradores y nuevos envíos. Los expedientes ya enviados conservan su referencia anterior. Una sección inactiva oculta sus requisitos del registro público.</p>
@if(grupos.Count == 0) { <div class="silab-panel p-4"><h2>Prepare la lista de requisitos</h2><p>Cree una sección y añada los requisitos que deben presentar los propietarios.</p></div> }
@foreach(var seccion in grupos) {
 var filas = Model.Requisitos.Where(r => r.SeccionId == seccion?.Id).ToList();
 <section class="silab-panel p-4 mt-4" aria-label="@(seccion?.Nombre ?? "Requisitos generales")">
 <div class="silab-page-heading"><div><h2>@(seccion?.Nombre ?? "Requisitos generales")</h2>
 @if(seccion is not null) { <p>@seccion.Descripcion</p><span class="silab-status">@(seccion.Activa ? "Sección activa" : "Sección inactiva") · Orden @seccion.Orden</span> } else { <p>Requisitos que todavía no tienen una sección asignada.</p> }
 </div>
 @if(seccion is not null) {
 <div class="admin-actions"><a asp-action="Seccion" asp-route-id="@seccion.Id" class="btn silab-btn-outline">Editar sección</a>
 <form asp-action="EstadoSeccion" method="post"><input type="hidden" name="id" value="@seccion.Id" /><input type="hidden" name="version" value="@seccion.Version" /><input type="hidden" name="activa" value="@((!seccion.Activa).ToString().ToLowerInvariant())" /><button class="btn silab-btn-outline">@(seccion.Activa ? "Desactivar sección" : "Activar sección")</button></form>
 <form asp-action="EliminarSeccion" method="post" data-confirm="¿Eliminar esta sección vacía? Los expedientes anteriores se conservarán."><input type="hidden" name="id" value="@seccion.Id" /><input type="hidden" name="version" value="@seccion.Version" /><button class="btn silab-btn-outline">Eliminar sección</button></form></div>
 }
 </div>
 @if(filas.Count == 0) { <p class="text-muted">Esta sección no tiene requisitos. Añada el primero para publicarlo.</p> } else {
 <ul class="admin-requirement-list">
 @foreach(var r in filas) {
 <li><div class="admin-requirement-copy"><strong>@r.Nombre</strong><span class="text-muted">@(r.Obligatorio ? "Obligatorio" : "Opcional") · @(r.Activo ? "Activo" : "Inactivo") · v@(r.Version) · Orden @r.Orden</span></div>
 <div class="admin-actions"><a asp-action="Requisito" asp-route-id="@r.Id" class="btn silab-btn-outline" aria-label="Editar requisito @r.Nombre">Editar</a>
 <form asp-action="EstadoRequisito" method="post"><input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="version" value="@r.Version" /><input type="hidden" name="activo" value="@((!r.Activo).ToString().ToLowerInvariant())" /><button class="btn silab-btn-outline" aria-label="@(r.Activo ? "Desactivar" : "Activar") requisito @r.Nombre">@(r.Activo ? "Desactivar" : "Activar")</button></form>
 <form asp-action="EliminarRequisito" method="post" data-confirm="¿Eliminar este requisito del catálogo? Se conservarán los documentos y expedientes anteriores."><input type="hidden" name="id" value="@r.Id" /><input type="hidden" name="version" value="@r.Version" /><button class="btn silab-btn-outline" aria-label="Eliminar requisito @r.Nombre">Eliminar</button></form></div></li>
 }
 </ul> }
 @if(seccion is not null && filas.Count > 0) { <p class="text-muted">Para eliminar la sección, mueva o elimine antes sus requisitos.</p> }
 <a asp-action="Requisito" asp-route-seccionId="@(seccion?.Id)" class="btn silab-btn-outline mt-3">Agregar requisito a @(seccion?.Nombre ?? "requisitos generales")</a>
 </section>
}
</div>
