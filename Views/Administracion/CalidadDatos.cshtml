@model List<SEDESLABORATORIO.Data.Entities.Laboratorio>
@{ ViewData["Title"] = "Validación institucional de datos"; }
<div class="container silab-page"><h1>Validación institucional de datos</h1><p>Estos registros requieren contrastarse con la fuente del SEDES. No se asignan propietarios ni vigencias por suposición. Los registros sin validar no se publican en producción.</p><section class="silab-panel p-4 mb-3"><h2>Establecimientos pendientes</h2><ul>@foreach(var l in Model) { <li>#@l.Id · @l.Nombre · @l.Municipio · propietario: @(l.PropietarioId?.ToString() ?? "Sin registrar") · vigencia: @(l.VigenciaHasta?.ToString("dd/MM/yyyy") ?? "Sin registrar")</li> }</ul>@if(Model.Count == 0) { <p>No hay establecimientos pendientes en esta comprobación.</p> }</section><section class="silab-panel p-4"><h2>Comprobaciones del expediente</h2><p>Solicitudes con datos incompletos o dañados: @string.Join(", ", (List<int>)ViewBag.SolicitudesInvalidas)</p><p>Solicitudes con copias históricas ilegibles: @string.Join(", ", (List<int>)ViewBag.CopiasInvalidas)</p><p>Documentos cuyo PDF no está disponible: @string.Join(", ", (List<int>)ViewBag.ArchivosFaltantes)</p><p>Elementos activos de tipos y municipios: @ViewBag.SinCatalogo</p><a asp-action="Catalogos">Configurar catálogos institucionales</a></section></div>
