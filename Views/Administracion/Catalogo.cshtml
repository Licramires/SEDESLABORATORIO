@model CatalogoForm
@{ ViewData["Title"] = "Configurar catálogo"; }
<div class="container silab-page"><section class="silab-panel p-4"><h1>Configurar catálogo</h1><form method="post" enctype="multipart/form-data" class="workflow-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><label>Clase<select asp-for="Clase" class="form-select"><option value="tipo">Tipo de laboratorio</option><option value="municipio">Municipio</option><option value="inspeccion">Punto de verificación de inspección</option><option value="feriado">Feriado</option><option value="formulario_acta">Plantilla de acta</option><option value="formulario_citacion">Plantilla de citación</option></select></label><label>Nombre (para feriados: yyyy-MM-dd)<input asp-for="Nombre" class="form-control" /></label><label>Referencia institucional o artículo<textarea asp-for="Referencia" class="form-control"></textarea></label><label><input asp-for="Activo" /> Activo</label><label>Plantilla PDF (obligatoria para formularios, hasta 10 MB)<input asp-for="Plantilla" type="file" accept=".pdf" class="form-control" /></label><button class="btn silab-btn-primary">Guardar</button><a asp-action="Catalogos">Volver a catálogos</a></form></section></div>
