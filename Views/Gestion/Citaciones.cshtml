@model List<SEDESLABORATORIO.Data.Entities.Citacion>
@using SEDESLABORATORIO.Infrastructure
@{ ViewData["Title"] = "Citaciones"; }
<div class="container silab-page"><h1>Citaciones emitidas</h1><p>Las citaciones se registran desde una inspección con observaciones o incumplimientos. @if(User.IsInRole("supervisor")) { <a asp-action="Actas">Consultar mis actas</a> }</p><p>Fechas de Bolivia. La evidencia y el estado se conservan dentro del expediente.</p><div class="silab-panel table-responsive"><table class="table silab-table"><thead><tr><th>Número</th><th>Establecimiento</th><th>Emisión</th><th>Vencimiento</th><th>Estado</th><th>Evidencia</th><th>Expediente</th></tr></thead><tbody>@foreach(var c in Model) { <tr><td>@c.Id</td><td>@TramiteDetalleModel.DatosDe(c.Solicitud).NombreLaboratorio</td><td>@c.FechaEmision.ToString("dd/MM/yyyy")</td><td>@c.Vencimiento.ToString("dd/MM/yyyy")</td><td>@(c.FechaAtencion.HasValue ? "Atendida" : c.Vencimiento.Date < TramiteService.HoraBolivia.Date ? "Vencida" : "Pendiente")</td><td><a asp-action="Descargar" asp-route-id="@c.Id" asp-route-tipo="citacion">Ver evidencia</a></td><td><a asp-action="Detalle" asp-route-id="@c.SolicitudId">Ver trámite</a></td></tr> }@if(Model.Count == 0) { <tr><td colspan="7">No hay citaciones para sus expedientes.</td></tr> }</tbody></table></div></div>
