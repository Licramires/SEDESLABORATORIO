@{ ViewData["Title"] = "Corregir período de consulta"; }
<div class="container silab-page"><section class="silab-panel p-4"><h1>Corregir período de consulta</h1><p role="alert" class="alert alert-danger">Indique fechas válidas: hasta debe ser igual o posterior a desde y el período no debe superar 10 años.</p><form asp-action="Index" method="get" class="workflow-form"><label>Desde<input type="date" name="desde" value="@ViewBag.Desde" required class="form-control" /></label><label>Hasta<input type="date" name="hasta" value="@ViewBag.Hasta" required class="form-control" /></label><label>Municipio (opcional)<input name="municipio" value="@Context.Request.Query["municipio"]" class="form-control" /></label><button class="btn silab-btn-primary">Consultar período</button><a asp-action="Index">Volver al período predeterminado</a></form></section></div>
