@model SEDESLABORATORIO.SolicitudSeguimiento.Models.SolicitudSeguimientoDetalleViewModel

@{
    ViewData["Title"] = "Detalle de solicitud";
}

<div class="container silab-page">
    <div class="silab-panel">
        <div class="silab-panel-header">
            <div>
                <span class="text-muted small">PORTAL DE TRÁMITES · DETALLE</span>
                <h1>Solicitud #@Model.Id</h1>
            </div>
            <span class="silab-status">@Model.Estado</span>
        </div>

        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success m-3" role="alert">@successMessage</div>
        }

        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger m-3" role="alert">@errorMessage</div>
        }

        <div class="p-4">
            <dl class="row mb-4">
                <dt class="col-sm-3 text-muted">Estado</dt>
                <dd class="col-sm-9">@Model.Estado</dd>
                <dt class="col-sm-3 text-muted">Fecha de creación</dt>
                <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                <dt class="col-sm-3 text-muted">Datos del laboratorio</dt>
                <dd class="col-sm-9"><pre class="mb-0 p-3 bg-light rounded">@Model.DatosLaboratorioPropuesto</pre></dd>
            </dl>

            @if (Model.PuedeEnviarse)
            {
                <form asp-action="Enviar" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">Enviar solicitud</button>
                </form>
            }

            <a asp-action="Index" class="btn btn-link">Volver al listado</a>
        </div>
    </div>
</div>