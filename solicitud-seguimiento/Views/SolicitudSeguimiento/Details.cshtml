@model SEDESLABORATORIO.SolicitudSeguimiento.Models.SolicitudSeguimientoDetalleViewModel

@{
    ViewData["Title"] = "Detalle de solicitud";
}

<div class="container silab-page">
    <div class="silab-panel">
        <div class="silab-panel-header">
            <div>
                <span class="silab-eyebrow">PORTAL DE TRÁMITES · DETALLE</span>
                <h1>Solicitud #@Model.Id</h1>
            </div>
            <span class="silab-status silab-status-@Model.Estado">@Model.Estado.Replace("_", " ")</span>
        </div>

        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success m-3" role="alert">@successMessage</div>
        }

        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger m-3" role="alert">@errorMessage</div>
        }

        <div class="p-4">
            <div class="silab-detail-grid">
                <section class="silab-detail-block">
                    <span class="silab-eyebrow">ESTADO DEL TRÁMITE</span>
                    <strong class="silab-detail-value">@Model.Estado.Replace("_", " ")</strong>
                    <span class="text-muted">Creada el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</span>
                </section>
                <section class="silab-detail-block">
                    <span class="silab-eyebrow">LABORATORIO PROPUESTO</span>
                    <strong class="silab-detail-value">@Model.NombreLaboratorio</strong>
                    <span class="text-muted">@Model.TipoLaboratorio · @Model.Coordenadas</span>
                </section>
            </div>
            @if (Model.PuedeEnviarse)
            {
                <form asp-action="Enviar" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn silab-btn-primary">Enviar solicitud</button>
                </form>
            }

            <a asp-action="Index" class="btn silab-btn-outline">Volver al listado</a>
        </div>
    </div>
</div>