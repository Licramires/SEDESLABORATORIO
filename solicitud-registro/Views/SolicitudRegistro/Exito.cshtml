@{
    ViewData["Title"] = "Solicitud Enviada";
}

<div class="container silab-page">
    <div class="silab-empty-state silab-success-state">
        <span class="silab-card-icon silab-card-icon-success">✓</span>
        <span class="silab-eyebrow">TRÁMITE REGISTRADO</span>
        <h1>¡Solicitud enviada con éxito!</h1>
        <p>Tus datos y documentos fueron registrados correctamente y quedaron en revisión.</p>
    @if (TempData["SolicitudCreada"] is not null)
    {
        <p class="silab-reference">Número de solicitud: <strong>#@TempData["SolicitudCreada"]</strong></p>
    }
    
        <div class="silab-quick-actions">
            <a asp-area="solicitud-seguimiento" asp-controller="SolicitudSeguimiento" asp-action="Index" class="btn silab-btn-primary">Ver mis trámites</a>
            <a asp-area="solicitud-registro" asp-controller="SolicitudRegistro" asp-action="Nueva" class="btn silab-btn-outline">Nueva solicitud</a>
        </div>
    </div>
</div>