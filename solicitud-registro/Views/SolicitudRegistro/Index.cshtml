@{
    ViewData["Title"] = "Solicitud de registro";
}

<div class="container silab-page">
    <div class="silab-page-heading">
        <div>
            <span class="silab-eyebrow">PORTAL DE TRÁMITES · PROPIETARIO</span>
            <h1>Solicitud de registro</h1>
            <p>Registra un nuevo establecimiento y adjunta la documentación requerida.</p>
        </div>
        <a asp-action="Nueva" class="btn silab-btn-primary">Iniciar solicitud</a>
    </div>
    <section class="silab-panel silab-info-banner">
        <span class="silab-card-icon">01</span>
        <div>
            <h2>Antes de comenzar</h2>
            <p>Ten preparados los datos del establecimiento, sus coordenadas y los documentos PDF solicitados.</p>
        </div>
    </section>
</div>
