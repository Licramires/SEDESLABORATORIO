@model SEDESLABORATORIO.SolicitudRegistro.Models.NuevaSolicitudViewModel
@{
    ViewData["Title"] = "Nueva solicitud";
    var tipos = (List<string>)ViewBag.Tipos;
    var municipios = (List<string>)ViewBag.Municipios;
}
<div class="container silab-page">
    <div class="silab-page-heading registration-heading"><div><h1>Nueva solicitud de apertura</h1><p>Complete el formulario y adjunte los documentos requeridos.</p></div></div>
    <form asp-area="solicitud-registro" asp-controller="SolicitudRegistro" asp-action="Nueva" method="post" enctype="multipart/form-data" class="registration-form">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <section class="silab-panel registration-section">
            <h2>Datos del establecimiento</h2><p>Ingrese la información general de su laboratorio. Los campos con * son obligatorios.</p>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="Municipio" class="form-label required">Municipio</label>
                    @if (municipios.Count > 0) { <select asp-for="Municipio" class="form-select" required><option value="">Seleccione un municipio</option>@foreach(var m in municipios) { <option value="@m">@m</option> }</select> }
                    else { <input asp-for="Municipio" maxlength="100" required class="form-control" /><p class="text-muted small mt-2">Catálogo institucional pendiente. La captura libre solo se permite en desarrollo.</p> }
                    <span asp-validation-for="Municipio" class="text-danger"></span>
                </div>
                <div class="col-md-6"><label asp-for="TipoLaboratorio" class="form-label required">Tipo de laboratorio</label>
                    @if (tipos.Count > 0) { <select asp-for="TipoLaboratorio" class="form-select" required><option value="">Seleccione un tipo</option>@foreach(var t in tipos) { <option value="@t">@t</option> }</select> }
                    else { <input asp-for="TipoLaboratorio" maxlength="100" required class="form-control" placeholder="Tipo de laboratorio" /> }
                    <span asp-validation-for="TipoLaboratorio" class="text-danger"></span>
                </div>
                <div class="col-md-6"><label asp-for="NombreLaboratorio" class="form-label required">Nombre del laboratorio</label><input asp-for="NombreLaboratorio" maxlength="200" required class="form-control" placeholder="Ej. Laboratorio Central BioTest" /><span asp-validation-for="NombreLaboratorio" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Telefono" class="form-label">Teléfono de contacto</label><input asp-for="Telefono" maxlength="50" type="tel" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Direccion" class="form-label">Dirección de referencia</label><input asp-for="Direccion" maxlength="500" class="form-control" /></div>
                <div class="col-md-6"><label asp-for="Codigo" class="form-label">Código institucional (si dispone de uno)</label><input asp-for="Codigo" maxlength="100" class="form-control" /></div>
            </div>
        </section>
        <section class="silab-panel registration-section">
            <h2>Ubicación del establecimiento</h2><p>Señale la ubicación para facilitar las inspecciones y la consulta pública.</p>
            <div class="registration-map-grid">
                <div id="solicitud-map" class="solicitud-map" aria-label="Previsualización de la ubicación del laboratorio"></div>
                <div><div class="mb-3"><label asp-for="Latitud" class="form-label required">Latitud</label><input asp-for="Latitud" type="number" step="any" min="-90" max="90" required class="form-control" placeholder="-17.3935" /><span asp-validation-for="Latitud" class="text-danger"></span></div>
                    <div><label asp-for="Longitud" class="form-label required">Longitud</label><input asp-for="Longitud" type="number" step="any" min="-180" max="180" required class="form-control" placeholder="-66.1570" /><span asp-validation-for="Longitud" class="text-danger"></span></div>
                    <p class="solicitud-map-help">Escriba las coordenadas o arrastre el marcador para ajustar la ubicación.</p>
                </div>
            </div>
        </section>
        <section class="silab-panel registration-section">
            <h2>Requisitos para habilitación, apertura y funcionamiento</h2><p>Prepare los documentos publicados y complete los obligatorios antes de enviar a revisión.</p>
            <partial name="_RequisitosRegistro" model="(List<SEDESLABORATORIO.Data.Entities.Requisito>)ViewBag.Requisitos" />
            <p class="mb-4"><a asp-area="publico" asp-controller="Publico" asp-action="Requerimientos" target="_blank" rel="noopener">Ver el apartado de requerimientos</a></p>
            <div class="document-upload-zone">
                <h3>Documentación legal y administrativa</h3>
                <p>Agregue PDF uno por uno o seleccione varios. Cada selección se suma a la lista; puede quitar archivos antes de guardar. Hasta 10 MB por PDF y 50 MB por esta carga. También puede guardar sin archivos y continuar después.</p>
                <label for="DocumentosPdf" class="form-label">Agregar archivos PDF a la lista</label>
                <input asp-for="DocumentosPdf" type="file" multiple accept=".pdf,application/pdf" class="form-control" />
                <span asp-validation-for="DocumentosPdf" class="text-danger d-block mt-2"></span>
                <div id="pdf-selection" class="mt-3" hidden><p id="pdf-selection-status" role="status" aria-live="polite"></p><p class="small text-muted">Los archivos de esta lista se guardan al pulsar «Guardar y completar requisitos».</p><ul id="pdf-selection-list" class="list-group"></ul></div>
                <p id="pdf-selection-error" class="text-danger mt-2" role="alert"></p>
                <noscript><p>Puede guardar el borrador sin archivos y agregarlos uno por uno en el siguiente paso.</p></noscript>
            </div>
        </section>
        <div class="silab-panel registration-actions"><a asp-area="" asp-controller="Gestion" asp-action="Index" class="btn silab-btn-outline">Cancelar</a><button type="submit" class="btn silab-btn-primary"><partial name="_Icon" model='"upload"' />Guardar y completar requisitos</button></div>
    </form>
</div>

@section Scripts {
    <script src="~/js/pdf-selection.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        (() => {
            const mapElement = document.getElementById("solicitud-map");
            const latitudeInput = document.getElementById("Latitud");
            const longitudeInput = document.getElementById("Longitud");

            if (!mapElement || !latitudeInput || !longitudeInput || typeof L === "undefined") {
                return;
            }

            const defaultLocation = [-17.3935, -66.1570];
            const parseCoordinate = (value, fallback) => {
                const coordinate = Number.parseFloat(value.replace(",", "."));
                return Number.isFinite(coordinate) ? coordinate : fallback;
            };
            const isValidLocation = (latitude, longitude) =>
                latitude >= -90 && latitude <= 90 && longitude >= -180 && longitude <= 180;

            const map = L.map(mapElement).setView(defaultLocation, 13);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                attribution: "&copy; OpenStreetMap contributors"
            }).addTo(map);

            const marker = L.marker(defaultLocation, { draggable: true }).addTo(map);

            const updateMarkerFromInputs = () => {
                const latitude = parseCoordinate(latitudeInput.value, defaultLocation[0]);
                const longitude = parseCoordinate(longitudeInput.value, defaultLocation[1]);

                if (!isValidLocation(latitude, longitude)) {
                    return;
                }

                const location = [latitude, longitude];
                marker.setLatLng(location);
                map.setView(location, Math.max(map.getZoom(), 13));
            };

            marker.on("dragend", () => {
                const location = marker.getLatLng();
                latitudeInput.value = location.lat.toFixed(6);
                longitudeInput.value = location.lng.toFixed(6);
            });

            latitudeInput.addEventListener("input", updateMarkerFromInputs);
            longitudeInput.addEventListener("input", updateMarkerFromInputs);

            if (latitudeInput.value && longitudeInput.value) {
                updateMarkerFromInputs();
            }

            setTimeout(() => map.invalidateSize(), 100);
        })();
    </script>
}
