      SELECT "t"."Id", "t"."Codigo", "t"."DatosLaboratorioPropuesto", "t"."Direccion", "t"."EsRenovacion", "t"."Estado", "t"."FechaCierre", "t"."FechaCreacion", "t"."FechaEnvio", "t"."FirmaLegalPdf", "t"."InformeCierrePdf", "t"."LaboratorioId", "t"."MotivoRechazo", "t"."Municipio", "t"."OrigenObservacion", "t"."PrimerEnvio", "t"."PropietarioId", "t"."RequiereNuevaInspeccion", "t"."RequisitosJson", "t"."RequisitosReconstruidos", "t"."Telefono", "t"."Version", "t"."VigenciaOtorgadaDesde", "t"."VigenciaOtorgadaHasta", "d"."Id", "d"."Actual", "d"."ArchivoPdf", "d"."EstadoRevision", "d"."FechaCarga", "d"."FechaRevision", "d"."NombreArchivo", "d"."NombreRequisito", "d"."Observacion", "d"."RequisitoId", "d"."RevisorId", "d"."SolicitudId", "d"."VersionArchivo", "i"."Id", "i"."Acta", "i"."ActaPdf", "i"."Citacion", "i"."DiasSubsanacion", "i"."Estado", "i"."Fecha", "i"."FechaFin", "i"."ListaVerificacionJson", "i"."NotasAdicionales", "i"."PlantillaPdf", "i"."PlantillaVersion", "i"."PlazoSubsanacion", "i"."Programada", "i"."Resultado", "i"."SolicitudId", "i"."SupervisorId"&#xD;
      FROM (&#xD;
          SELECT "s"."Id", "s"."Codigo", "s"."DatosLaboratorioPropuesto", "s"."Direccion", "s"."EsRenovacion", "s"."Estado", "s"."FechaCierre", "s"."FechaCreacion", "s"."FechaEnvio", "s"."FirmaLegalPdf", "s"."InformeCierrePdf", "s"."LaboratorioId", "s"."MotivoRechazo", "s"."Municipio", "s"."OrigenObservacion", "s"."PrimerEnvio", "s"."PropietarioId", "s"."RequiereNuevaInspeccion", "s"."RequisitosJson", "s"."RequisitosReconstruidos", "s"."Telefono", "s"."Version", "s"."VigenciaOtorgadaDesde", "s"."VigenciaOtorgadaHasta"&#xD;
          FROM "Solicitudes" AS "s"&#xD;
          WHERE "s"."Codigo" = 'DEMO-LEGAL'&#xD;
          LIMIT 2&#xD;
      ) AS "t"&#xD;
      LEFT JOIN "Documentos" AS "d" ON "t"."Id" = "d"."SolicitudId"&#xD;
      LEFT JOIN "Inspecciones" AS "i" ON "t"."Id" = "i"."SolicitudId"&#xD;
      ORDER BY "t"."Id", "d"."Id"&#xD;
