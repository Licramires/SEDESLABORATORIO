      FROM (&#xD;
          SELECT "s"."Id", "s"."Codigo", "s"."DatosLaboratorioPropuesto", "s"."Direccion", "s"."EsRenovacion", "s"."Estado", "s"."FechaCierre", "s"."FechaCreacion", "s"."FechaEnvio", "s"."FirmaLegalPdf", "s"."InformeCierrePdf", "s"."LaboratorioId", "s"."MotivoRechazo", "s"."Municipio", "s"."OrigenObservacion", "s"."PrimerEnvio", "s"."PropietarioId", "s"."RequiereNuevaInspeccion", "s"."RequisitosJson", "s"."RequisitosReconstruidos", "s"."Telefono", "s"."Version", "s"."VigenciaOtorgadaDesde", "s"."VigenciaOtorgadaHasta"&#xD;
          FROM "Solicitudes" AS "s"&#xD;
          WHERE "s"."Codigo" = 'DEMO-LEGAL'&#xD;
          LIMIT 2&#xD;
      ) AS "t"&#xD;
      LEFT JOIN "Documentos" AS "d" ON "t"."Id" = "d"."SolicitudId"&#xD;
      LEFT JOIN "Inspecciones" AS "i" ON "t"."Id" = "i"."SolicitudId"&#xD;
      ORDER BY "t"."Id", "d"."Id"&#xD;
