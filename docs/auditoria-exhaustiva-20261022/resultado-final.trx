      SELECT "r"."Id", "r"."Activo", "r"."Eliminado", "r"."Nombre", "r"."Obligatorio", "r"."Orden", "r"."PlantillaPdf", "r"."SeccionId", "r"."Version", "s"."Id", "s"."Activa", "s"."Descripcion", "s"."Eliminada", "s"."Nombre", "s"."Orden", "s"."Version"&#xD;
      FROM "Requisitos" AS "r"&#xD;
      LEFT JOIN "SeccionesRequisitos" AS "s" ON "r"."SeccionId" = "s"."Id"&#xD;
      WHERE "r"."Activo" AND NOT ("r"."Eliminado") AND ("s"."Id" IS NULL OR ("s"."Activa" AND NOT ("s"."Eliminada")))&#xD;
      ORDER BY CASE&#xD;
          WHEN "s"."Id" IS NULL THEN 0&#xD;
          ELSE "s"."Orden"&#xD;
      END, "r"."SeccionId", "r"."Orden", "r"."Id"&#xD;
