@{
    ViewData["Title"] = "Panel de acceso";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "sin rol";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="text-muted small">CU05 · AUTENTICACIÓN</span>
            <h1 class="mb-1">Hola, @User.Identity?.Name</h1>
            <p class="text-muted mb-0">Sesión iniciada como <strong>@role</strong>.</p>
        </div>
        <form asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-secondary">Cerrar sesión</button>
        </form>
    </div>

    <div class="alert alert-success" role="status">
        Tu identidad fue validada correctamente. El resto de módulos podrá usar este rol para autorizar sus operaciones.
    </div>
</div>
