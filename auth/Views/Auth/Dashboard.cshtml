@{
    ViewData["Title"] = "Mi espacio de trabajo";
    var admin = User.IsInRole("administrador"); var supervisor = User.IsInRole("supervisor");
    var coordinador = User.IsInRole("coordinador"); var gerente = User.IsInRole("gerente");
    var propietario = User.IsInRole("propietario");
    var tarea = admin ? "Administre usuarios, permisos y requisitos de registro." : supervisor ? "Organice sus visitas y registre el acta desde cada inspección asignada." : coordinador ? "Revise documentos, asigne inspecciones y valide las actas recibidas." : gerente ? "Consulte indicadores calculados con los trámites guardados y exporte sus informes." : propietario ? "Complete sus solicitudes y consulte las correcciones pendientes." : "Revise licencia, plano y acta antes de emitir su decisión legal.";
}
<div class="container silab-page"><div class="silab-page-heading"><div><h1>Hola, @User.Identity?.Name</h1><p>@tarea</p></div><form asp-action="Logout" method="post"><button class="btn silab-btn-outline">Cerrar sesión</button></form></div>
<section class="silab-panel p-4"><h2>Trabajo principal</h2><div class="workflow-actions">
@if(propietario) { <a asp-area="solicitud-registro" asp-controller="SolicitudRegistro" asp-action="Nueva" class="btn silab-btn-primary">Nueva solicitud</a><a asp-area="" asp-controller="Gestion" asp-action="Index" class="btn silab-btn-outline">Mis trámites</a> }
else { <a asp-area="" asp-controller="@(admin ? "Administracion" : gerente ? "Metricas" : "Gestion")" asp-action="@(admin ? "Usuarios" : supervisor ? "Agenda" : "Index")" class="btn silab-btn-primary">@(admin ? "Administrar usuarios" : supervisor ? "Abrir mi agenda" : coordinador ? "Abrir bandeja de trámites" : gerente ? "Ver métricas e informes" : "Abrir revisión legal")</a> }
@if(admin) { <a asp-area="" asp-controller="Administracion" asp-action="Roles" class="btn silab-btn-outline">Roles y permisos</a><a asp-area="" asp-controller="Administracion" asp-action="Requisitos" class="btn silab-btn-outline">Requisitos de registro</a> }
@if(supervisor) { <a asp-area="" asp-controller="Gestion" asp-action="Actas" class="btn silab-btn-outline">Actas emitidas</a> }
</div><p class="mt-3 mb-0">Los avisos y las tareas nuevas están en <a asp-area="" asp-controller="Notificaciones" asp-action="Index">Notificaciones</a>.</p></section></div>
