@{
    ViewData["Title"] = "Panel de acceso";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "sin rol";
}

<div class="container silab-page">
    <div class="silab-page-heading">
        <div>
            <span class="silab-eyebrow">CU05 · AUTENTICACIÓN</span>
            <h1>Hola, @User.Identity?.Name</h1>
            <p>Panel de acceso y estado de tu sesión.</p>
        </div>
        <form asp-action="Logout" method="post">
            <button type="submit" class="btn silab-btn-outline">Cerrar sesión</button>
        </form>
    </div>

    <div class="silab-dashboard-grid">
        <section class="silab-panel silab-role-card">
            <span class="silab-card-icon">SL</span>
            <div>
                <span class="silab-eyebrow">ROL ACTIVO</span>
                <h2>@role</h2>
                <p>Tu identidad fue validada correctamente.</p>
            </div>
        </section>
        <section class="silab-panel silab-quick-card">
            <span class="silab-eyebrow">ACCESOS RÁPIDOS</span>
            <h2>Continúa tu gestión</h2>
            @if (User.IsInRole("propietario"))
            {
                <div class="silab-quick-actions">
                    <a asp-area="solicitud-registro" asp-controller="SolicitudRegistro" asp-action="Nueva" class="btn silab-btn-primary">Nueva solicitud</a>
                    <a asp-area="solicitud-seguimiento" asp-controller="SolicitudSeguimiento" asp-action="Index" class="btn silab-btn-outline">Ver mis trámites</a>
                </div>
            }
            else
            {
                <p class="mb-0">Los accesos operativos de tu rol se habilitarán en los siguientes sprints.</p>
            }
        </section>
    </div>
</div>
